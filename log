#!/usr/bin/env python3
"""Bind structural site spellings to a real full classified Tessent report."""
import argparse
import hashlib
import json
from collections import defaultdict
from pathlib import Path
import sys
sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
from fault_report import norm, parse_fault_line


def sha(p):
    return hashlib.sha256(p.read_bytes()).hexdigest()


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--catalog', type=Path, default=Path(__file__).resolve().parent / 'structural/cell2Fault.log')
    p.add_argument('--report', type=Path, required=True)
    p.add_argument('--out', type=Path, required=True)
    a = p.parse_args()
    if a.out.exists():
        raise ValueError('Output exists; choose a fresh directory')
    sites = defaultdict(set)
    classes = defaultdict(int)
    for i, line in enumerate(a.report.open(), 1):
        try:fields=parse_fault_line(line)
        except ValueError as exc:raise ValueError('Unexpected report line {}: {}'.format(i,exc))
        if fields is None:continue
        sites[norm(fields[2])].add(fields[2])
        classes[fields[1]] += 1
    if not any(k == 'DS' or k.startswith('DS.') for k in classes):
        raise ValueError('No DS faults: verify full classified report, not AAB-only export')
    groups = {}
    target = None
    for line in a.catalog.read_text().splitlines():
        if line.startswith('Target: '):
            target = line[8:]
            if target in groups:
                raise ValueError('Duplicate target')
            groups[target] = set()
        elif line:
            if target is None:
                raise ValueError('Site before Target')
            groups[target].update(sites.get(norm(line), ()))
    if len(groups) != 44 or any(not g for g in groups.values()):
        raise ValueError('Expected 44 targets with nonempty report-site associations; check naming')
    a.out.mkdir(parents=True)
    with (a.out / 'cell2Fault.log').open('w') as f:
        for target, group in groups.items():
            f.write('Target: ' + target + '\n')
            f.write(''.join(s + '\n' for s in sorted(group)))
    manifest = dict(status='REPORT_NAME_BOUND_NOT_COLLAPSE_EQUIVALENCE_VALIDATED',
                    candidates=44, site_counts={k: len(v) for k, v in groups.items()},
                    class_counts=dict(classes),
                    input_sha256={str(x): sha(x) for x in (a.catalog, a.report)},
                    output_sha256=sha(a.out / 'cell2Fault.log'))
    (a.out / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    print('BOUND', a.out / 'cell2Fault.log')


if __name__ == '__main__':
    main()
