#CAtpg_var_file_WM

set lp_var   $env(LOWPOWER_SWITCH)
set tb_var   $env(SAVE_TB_SWITCH)
set samp_var $env(SAMPLE_SWITCH)
set pf_var   $env(PERFORMANCE_SWITCH)
set mt_var   $env(MULTICORE_SWITCH)
set WITA_YELLOW_ROOT $env(WITA_YELLOW_ROOT)
set non_scan_var $env(NON_SCAN)
set batch_id $env(BATCH_ID)
set version $env(VERSION)

if {$lp_var == ""} {
    set lp_var "on"
}

if {$tb_var == ""} {
   set tb_var "off"
}

if {$samp_var == ""} {
   set samp_var "default"
}

if {$pf_var == ""} {
   set pf_var "off"
}

if {$mt_var == ""} {
   set mt_var "off"
}


puts "LOWPOWER_SWITCH     : $lp_var"
puts "TESTBENCH_SWITCH    : $tb_var"
puts "SAMPLE_SWITCH       : $samp_var"
puts "PERFORMANCE_SWITCH  : $pf_var"
puts "MULTICORE_SWITCH    : $mt_var"
puts "WITA_YELLOW_ROOT   : $WITA_YELLOW_ROOT"
puts "NON_SCAN : $non_scan_var"
puts "BATCH_ID : $batch_id"
