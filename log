#!/usr/bin/env python3
"""Regression for actual Tessent quoted escaped-identifier report spelling."""
from pathlib import Path
import json
import subprocess
import sys
import tempfile
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT))
from fault_report import norm,parse_fault_line
from run_ffps import faults,new_problem_sites,association
sample=r'''0   DI.SCAN   "/\dfdct_dout[0]$_DFFE_PP_ /Q"
1   DI.SCAN   "/\dfdct_dout[0]$_DFFE_PP_ /Q"
0   DS      "/\dfdct_dout[0]$_DFFE_PP_ /QN"
1   DS      "/\dfdct_dout[0]$_DFFE_PP_ /QN"
'''
assert parse_fault_line(sample.splitlines()[0])[2]==r'"/\dfdct_dout[0]$_DFFE_PP_ /Q"'
assert norm(parse_fault_line(sample.splitlines()[0])[2])=='dfdct_dout[0]$_DFFE_PP_/Q'
assert norm(r'/dfdct_dout\[0\]$_DFFE_PP_/Q')==norm(r'"/\dfdct_dout[0]$_DFFE_PP_ /Q"')
for bad in ['0 DS "unterminated','0 DS /two tokens','0 DS','2 DS /pin']:
    try:parse_fault_line(bad)
    except ValueError:pass
    else:raise AssertionError('Malformed line accepted: '+bad)
with tempfile.TemporaryDirectory() as d:
    p=Path(d);report=p/'quoted.report';report.write_text(sample)
    actual=faults(report);assert len(actual)==4
    canonical=p/'canonical.report';canonical.write_text(sample.replace('"/\\','/').replace(' /Q"','/Q').replace(' /QN"','/QN'))
    assert faults(canonical)==actual
    changed=dict(actual);changed[('0','dfdct_dout[0]$_DFFE_PP_/QN')]='AU.PC'
    assert new_problem_sites(actual,changed)=={'dfdct_dout[0]$_DFFE_PP_/QN'}
    names=(ROOT/'data/candidates.txt').read_text().splitlines();catalog=p/'catalog.log'
    catalog.write_text(''.join('Target: '+n+'\n/dfdct_dout[0]$_DFFE_PP_/QN\n' for n in names))
    subprocess.run([sys.executable,'-B',str(ROOT/'ffps/bind_fault_sites.py'),'--catalog',str(catalog),'--report',str(report),'--out',str(p/'bound')],check=True)
    groups=association(p/'bound/cell2Fault.log',names)
    assert len(groups)==44 and all(v=={'dfdct_dout[0]$_DFFE_PP_/QN'} for v in groups.values())
    subprocess.run([sys.executable,'-B',str(ROOT/'tools/compare_coverage.py'),'--fs',str(report),'--ffps',str(canonical),'--detected','DS,DS.*','--out',str(p/'audit')],check=True)
print('QUOTED_ESCAPED_SITE_PARSER_BINDING_AND_COMPARISON_PASS; real ATPG not run')
